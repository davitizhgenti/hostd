# Scenes and rules: listed, applied, paused.
mkdir $XDG_CONFIG_HOME/hostd/scenes
cp quiet.toml $XDG_CONFIG_HOME/hostd/scenes/quiet.toml
mkdir $XDG_CONFIG_HOME/hostd/rules
cp bedtime.toml $XDG_CONFIG_HOME/hostd/rules/bedtime.toml
exec hostd -listen= &hostd&
waitfile $XDG_RUNTIME_DIR/hostd.sock
exec hostctl login unix://$XDG_RUNTIME_DIR/hostd.sock --token-file $XDG_RUNTIME_DIR/hostd-admin-token

exec hostctl scenes
stdout '^quiet +Quiet +apps +-$'

# Nothing to stop: reached already, no steps.
exec hostctl scene apply quiet
stdout 'applied \(v1\) \{"scene":"quiet","steps":\[\]\}'
exits 4 hostctl scene apply nope

exec hostctl rules
stdout '^bedtime +instance.started +scene quiet +0 +- +active +-$'
exec hostctl rule pause bedtime
exec hostctl rules
stdout 'paused: paused by hand +-$'
exec hostctl rule resume bedtime
exec hostctl rules
stdout 'active +-$'

# Nothing in progress: an update would not wait.
exec hostctl wait-quiet --max 1s
exec hostctl wait-quiet --idle --max 1s

# A broken rule file: the rule before it stays in use, and the file says why.
cp broken.toml $XDG_CONFIG_HOME/hostd/rules/bedtime.toml
waitout 'needs on' hostctl rules
stdout '^bedtime +instance.started +scene quiet +0 +- +active +needs on'
exec hostctl get rules bedtime
stdout 'the file is not in use: needs on'

# The same commands as every kind: apply, check, delete.
! exec hostctl apply -f broken.toml --kind rule --name worse --check
stdout 'rule/worse: rejected: .*needs on'
exec hostctl apply -f bedtime.toml --kind rule --name later --check
stdout 'rule/later: would be accepted'
exec hostctl apply -f bedtime.toml --kind rule --name later
exec hostctl rules
stdout '^later '
exec hostctl delete rule later
! exec hostctl get rules later
stderr 'no rule "later"'
# Scripts: a file says what to run; it runs now, with a token of its own.
exec hostctl apply -f hello.toml --kind script
exec hostctl scripts
stdout '^hello +- +audio +- +-$'
exec hostctl script run hello
stdout 'ran: exit 0'
! exec hostctl script run nothing
stderr 'no script "nothing"'
! exec hostctl apply -f admin.toml --kind script --name boss
stdout 'cannot have scope admin'

# A scene's sections belong to the modules that plan them: each is checked by
# its module, and one no module plans is refused with the ones there are.
exec hostctl apply -f all.toml --kind scene
stdout 'scene/all: applied'
exec hostctl scenes
stdout '^all +All three +apps, audio, display +-$'
! exec hostctl apply -f loud.toml --kind scene
stdout '\[audio\]: .*maximum'
! exec hostctl apply -f typo.toml --kind scene
stdout 'no module plans it .the sections are: apps, audio, display'
! exec hostctl apply -f clash.toml --kind scene
stdout 'is both in stop and in running'

-- all.toml --
name = "All three"
[audio]
volume = 40
[apps]
running = ["jellyfin"]
[display]
power = "on"
-- loud.toml --
[audio]
volume = 400
-- typo.toml --
[audoi]
volume = 4
-- clash.toml --
[apps]
stop    = ["a"]
running = ["a"]
-- hello.toml --
run    = "echo hi"
scopes = ["audio"]
-- admin.toml --
command = ["true"]
scopes  = ["admin"]
-- quiet.toml --
name = "Quiet"
[apps]
stop = ["game"]
-- bedtime.toml --
on = "instance.started"
do = { scene = "quiet" }
-- broken.toml --
do = { scene = "quiet" }
