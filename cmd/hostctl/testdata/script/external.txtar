# An external module (the Python example) is a module like the others.
[!exec:python3] skip
mkdir $XDG_CONFIG_HOME/hostd
cp hostd.toml $XDG_CONFIG_HOME/hostd/hostd.toml
mkdir $XDG_CONFIG_HOME/hostd/modules
cp lights.toml $XDG_CONFIG_HOME/hostd/modules/lights.toml
cp broken.toml $XDG_CONFIG_HOME/hostd/modules/broken.toml
exec sed -i s|@REPO@|$REPO| $XDG_CONFIG_HOME/hostd/modules/lights.toml
exec hostd -listen= &hostd&
waitfile $XDG_RUNTIME_DIR/hostd.sock
exec hostctl login unix://$XDG_RUNTIME_DIR/hostd.sock --token-file $XDG_RUNTIME_DIR/hostd-admin-token

# Its actions are commands, its routes and scope are in the API.
exec hostctl lights set porch --brightness 40
stdout 'applied'
exec hostctl lights dim_all
exec hostctl log --limit 5
stdout 'lights.set .*manual'
exits 4 hostctl lights set garage --brightness 1

# Its read is a command too, as a table because the manifest says how.
exec hostctl get lights lights
stdout 'LIGHT +BRIGHTNESS'
stdout 'porch +10'
exec hostctl get lights lights --json
stdout '"brightness": 10'

# The files are resources of the kind "module": what became of each.
exec hostctl modules
stdout 'lights +python3, .*lights.py +socket +running'
stdout 'broken +false +socket +failed: '

-- hostd.toml --
modules = ["apps"]
-- lights.toml --
command = ["python3", "@REPO@/examples/python-module/lights.py"]
-- broken.toml --
command = ["false"]
