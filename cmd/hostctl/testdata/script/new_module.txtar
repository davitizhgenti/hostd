# hostctl new module writes a module that runs: here the Python one, under hostd.
[!exec:python3] skip
exec hostctl new module garden --python
stdout 'garden/garden.py'
! exec hostctl new module garden --python
stderr 'exists already'
! exec hostctl new module Bad_Name --python
stderr 'cannot name a module'
! exec hostctl new module x
stderr 'choose --python or --go'

mkdir $XDG_CONFIG_HOME/hostd/modules
cp garden/garden.toml $XDG_CONFIG_HOME/hostd/modules/garden.toml
exec sed -i s|/path/to/garden|$WORK/garden| $XDG_CONFIG_HOME/hostd/modules/garden.toml
exec hostd -listen= &hostd&
waitfile $XDG_RUNTIME_DIR/hostd.sock
exec hostctl login unix://$XDG_RUNTIME_DIR/hostd.sock --token-file $XDG_RUNTIME_DIR/hostd-admin-token
exec hostctl garden hello --who you
stdout 'hello, you'
exec hostctl garden hello
stdout 'hello, world'
exec hostctl modules
stdout 'garden .*running'
kill -INT hostd
wait hostd
