# Secrets are read from standard input and never recorded.
exec hostd -listen= &hostd&
waitfile $XDG_RUNTIME_DIR/hostd.sock
exec hostctl login unix://$XDG_RUNTIME_DIR/hostd.sock --token-file $XDG_RUNTIME_DIR/hostd-admin-token

stdin value.txt
exec hostctl secret set db-pass
stdout 'applied'
exists $XDG_CONFIG_HOME/hostd/secrets/db-pass
grep '^hunter2$' $XDG_CONFIG_HOME/hostd/secrets/db-pass

exec hostctl log
stdout 'secret.set'
! stdout 'hunter2'
exec hostctl log --json
stdout '"value": "\[secret\]"'
! stdout 'hunter2'

# Not on the command line.
! exec hostctl secret set db-pass hunter2
stderr 'accepts at most 1 arg'

# Empty input is refused.
stdin empty.txt
! exec hostctl secret set other
stderr 'standard input, which was empty'

exec hostctl secret remove db-pass
! exists $XDG_CONFIG_HOME/hostd/secrets/db-pass

-- value.txt --
hunter2
-- empty.txt --
