# The catalog comes from .desktop files plus app files in ~/.config/hostd/apps.
env XDG_DATA_DIRS=$WORK/share
env XDG_DATA_HOME=$WORK/nothing
mkdir $XDG_CONFIG_HOME/hostd/apps
cp browser.toml $XDG_CONFIG_HOME/hostd/apps/browser.toml

exec hostd -listen= &hostd&
waitfile $XDG_RUNTIME_DIR/hostd.sock
exec hostctl login unix://$XDG_RUNTIME_DIR/hostd.sock --token-file $XDG_RUNTIME_DIR/hostd-admin-token

exec hostctl apps
stdout '^browser +Browser +exec +window +desktop +-$'
! stdout '^foot'
exec hostctl apps --all
stdout '^foot +Foot +exec +window +desktop \(hidden\) +-$'

# The old ID still finds a renamed app.
exec hostctl apps firefox-esr
stdout '"id": "browser"'
stdout '# ready, from desktop'
exits 4 hostctl apps nope

# A file dropped in the folder shows up by itself; a broken one is a problem
# on its own row, and does not touch the rest.
cp jellyfin.toml $XDG_CONFIG_HOME/hostd/apps/jellyfin.toml
cp oops.toml $XDG_CONFIG_HOME/hostd/apps/oops.toml
waitout '(?m)^jellyfin +jellyfin +docker +background +file +-$' hostctl apps
stdout '^oops +- +- +- +- +runner type "warp"'
stdout '^browser '

# Apps are resources like any other: apply, check, edit, delete.
exec hostctl apply -f show.toml --kind app --check
stdout 'app/show: would be accepted'
exec hostctl apply -f show.toml --kind app
exec hostctl apps
stdout '^show +Show +exec +window +file +-$'
exec hostctl get apps show
stdout 'imv'
stdout '# ready, from file, generation 1'
! exec hostctl apply -f oops.toml --kind app --name another
stdout 'runner type "warp"'
exec hostctl delete app show
! exec hostctl get apps show
stderr 'no app "show"'
# A file that overlays an app found on the machine: deleting it brings the
# app back as it was found. The app itself is not a file there is to delete.
exec hostctl delete app browser
exec hostctl apps
stdout '^firefox-esr +Firefox ESR +exec +window +desktop +-$'
! stdout '^browser '
! exec hostctl delete app firefox-esr
stderr 'comes from desktop'

kill -INT hostd
wait hostd

-- share/applications/firefox-esr.desktop --
[Desktop Entry]
Type=Application
Name=Firefox ESR
Exec=/usr/lib/firefox-esr/firefox-esr %u
-- share/applications/foot.desktop --
[Desktop Entry]
Type=Application
Name=Foot
Exec=foot
Categories=System;TerminalEmulator;
-- browser.toml --
extends = "firefox-esr"
id      = "browser"
name    = "Browser"
-- jellyfin.toml --
runner = { type = "docker", image = "docker.io/jellyfin/jellyfin" }
-- show.toml --
name = "Show"
runner = { type = "exec", command = ["imv", "{file}"] }
args = { file = "path" }
-- oops.toml --
runner = { type = "warp" }
