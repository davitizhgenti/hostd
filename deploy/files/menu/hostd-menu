#!/usr/bin/python3
"""hostd's menu: the on-screen list of running apps and the catalog.

hostd runs it as the hidden app "hostd-menu" and brings it forward with
the display.menu action (Super, a controller's Guide button). Choosing an
entry sends window.focus or app.start with the "local" token, so it counts
as someone at the screen. An entry's actions (right click, the Menu key,
controller X) open in a small box at the entry.

Keyboard: type to filter, up/down, Enter, Delete (close), Menu or Shift+F10
(actions), Escape. Mouse: click opens, right click shows the actions.
Controller: D-pad, A, B, X (actions). Going back, closing and starting are
hostd actions, like everything that changes the screen.
Needs python3-gi and gir1.2-gtk-4.0; talks to hostd over its unix socket.
"""

import http.client
import json
import os
import base64
import socket
import struct
import sys
import threading
import time

import gi

os.environ.setdefault("GTK_A11Y", "none")  # no accessibility bus on a TV session

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

APP_ID = "hostd-menu"  # its own entry in hostd's catalog, never listed

CSS = """
