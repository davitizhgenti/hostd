# --- hostd API ----------------------------------------------------------------


class UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, path, timeout=10):
        super().__init__("hostd", timeout=timeout)
        self.path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.path)


class API:
    def __init__(self):
        runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        self.socket = os.environ.get("HOSTD_SOCKET", os.path.join(runtime, "hostd.sock"))
        self.token = os.environ.get("HOSTD_TOKEN") or self._token_file()

    @staticmethod
    def _token_file():
        config = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
        try:
            with open(os.path.join(config, "hostd", "local.token")) as f:
                return f.read().strip()
        except OSError:
            return ""

    def call(self, method, path, body=None):
        conn = UnixHTTPConnection(self.socket)
        try:
            headers = {"Authorization": "Bearer " + self.token}
            data = None
            if body is not None:
                data = json.dumps(body).encode()
                headers["Content-Type"] = "application/json"
            conn.request(method, path, body=data, headers=headers)
            resp = conn.getresponse()
            payload = json.loads(resp.read() or b"null")
            if resp.status >= 400:
                err = (payload or {}).get("error", {})
                raise RuntimeError(err.get("message") or f"HTTP {resp.status}")
            return payload
        finally:
            conn.close()


class EventStream(threading.Thread):
    """Follows hostd's events (GET /v1/events, a WebSocket) and hands each
    to on_event on the GTK main loop. Reconnects with a growing pause when
    the connection drops. A minimal client: hostd sends unmasked text
    frames; the client answers pings and masks what it sends, as RFC 6455
    asks."""

    def __init__(self, api, on_event):
        super().__init__(daemon=True)
        self.api = api
        self.on_event = on_event
        self.connected = False

    def run(self):
        pause = 1
        while True:
            try:
                self.follow()
                pause = 1
            except (OSError, ValueError):  # hostd away or restarting; try again
                pass
            self.connected = False
            time.sleep(pause)
            pause = min(pause * 2, 30)

    def follow(self):
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(10)  # for connecting and the handshake
        sock.connect(self.api.socket)
        try:
            key = base64.b64encode(os.urandom(16)).decode()
            sock.sendall((
                "GET /v1/events?type=* HTTP/1.1\r\nHost: hostd\r\nUpgrade: websocket\r\n"
                "Connection: Upgrade\r\nSec-WebSocket-Version: 13\r\n"
                f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Protocol: hostd.v1\r\n"
                f"Authorization: Bearer {self.api.token}\r\n\r\n").encode())
            head = b""
            while b"\r\n\r\n" not in head:
                chunk = sock.recv(1024)
                if not chunk:
                    raise ValueError("connection closed during the handshake")
                head += chunk
            head, rest = head.split(b"\r\n\r\n", 1)
            if not head.startswith(b"HTTP/1.1 101"):
                raise ValueError(head.split(b"\r\n", 1)[0].decode(errors="replace"))
            # A local socket: when hostd stops, reads end at once, so a quiet
            # stream can wait for as long as it stays quiet.
            sock.settimeout(None)
            self.connected = True
            GLib.idle_add(self.on_event, {"type": "hostd.connected"})
            reader = _Frames(sock, rest)
            while True:
                opcode, payload = reader.next()
                if opcode == 0x1:  # text: one event
                    GLib.idle_add(self.on_event, json.loads(payload))
                elif opcode == 0x9:  # ping
                    _send_frame(sock, 0xA, payload)
                elif opcode == 0x8:  # close
                    return
        finally:
            sock.close()


class _Frames:
    """Reads WebSocket frames (unmasked, from the server)."""

    def __init__(self, sock, buffered):
        self.sock, self.buf = sock, buffered

    def _read(self, n):
        while len(self.buf) < n:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ValueError("connection closed")
            self.buf += chunk
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def next(self):
        message, opcode = b"", None
        while True:
            b0, b1 = self._read(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._read(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._read(8))[0]
            mask = self._read(4) if b1 & 0x80 else None
            data = self._read(n)
            if mask:
                data = bytes(c ^ mask[i % 4] for i, c in enumerate(data))
            op = b0 & 0x0F
            if op >= 0x8:  # control frames come whole, even inside a message
                return op, data
            opcode = opcode if op == 0 else op
            message += data
            if b0 & 0x80:  # FIN
                return opcode, message


def _send_frame(sock, opcode, payload):
    mask = os.urandom(4)
    head = bytes([0x80 | opcode, 0x80 | len(payload)])  # control frames: < 126 bytes
    sock.sendall(head + mask + bytes(c ^ mask[i % 4] for i, c in enumerate(payload)))


# --- controller input -----------------------------------------------------------

EV_KEY, EV_ABS = 0x01, 0x03
ABS_HAT0X, ABS_HAT0Y = 0x10, 0x11
BTN_SOUTH, BTN_EAST, BTN_WEST = 0x130, 0x131, 0x134  # A, B, X
BTN_DPAD = {0x220: "up", 0x221: "down", 0x222: "left", 0x223: "right"}
EVENT = struct.Struct("llHHi")  # struct input_event on 64-bit Linux


class Controllers:
    """Reads gamepads from /dev/input and reports navigation."""

    def __init__(self, on_nav):
        self.on_nav = on_nav
        self.open = {}  # path -> (fd, watch id)
        self.rescan()
        GLib.timeout_add_seconds(3, self.rescan)

    def rescan(self):
        try:
            names = os.listdir("/dev/input")
        except OSError:
            return True
        for name in names:
            path = os.path.join("/dev/input", name)
            if not name.startswith("event") or path in self.open:
                continue
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                continue
            watch = GLib.io_add_watch(fd, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.read, path)
            self.open[path] = (fd, watch)
        return True

    def read(self, fd, cond, path):
        try:
            data = os.read(fd, EVENT.size * 64)
        except BlockingIOError:
            return True
        except OSError:
            data = b""
        if not data:  # unplugged
            os.close(fd)
            self.open.pop(path, None)
            return False
        for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
            _, _, typ, code, value = EVENT.unpack_from(data, i)
            if typ == EV_KEY and value == 1:
                if code == BTN_SOUTH:
                    self.on_nav("choose")
                elif code == BTN_EAST:
                    self.on_nav("back")
                elif code == BTN_WEST:
                    self.on_nav("actions")
                elif code in BTN_DPAD:
                    self.on_nav(BTN_DPAD[code])
            elif typ == EV_ABS and code in (ABS_HAT0X, ABS_HAT0Y) and value != 0:
                if code == ABS_HAT0X:
                    self.on_nav("left" if value < 0 else "right")
                else:
                    self.on_nav("up" if value < 0 else "down")
        return True


# --- the window -----------------------------------------------------------------


class Menu(Gtk.ApplicationWindow):
    """One filterable list: running instances, then the catalog. An entry's
    actions (right click, Menu key, controller X) open at the entry: focus or
    close a running app, start an app, or one of its actions."""

    HINT = "enter open  right-click actions  del close  esc back  type to filter"
    ACTIONS_HINT = "enter run  esc close"

    def __init__(self, app, api):
        super().__init__(application=app, title="hostd")
        self.api = api
        self.apps = {}  # app ID -> app, from the last refresh
        self.shown = ""  # what the list shows, to notice changes
        self.actions_for = None  # the row whose actions are open
        self.set_decorated(False)

        bar = Gtk.Box(spacing=0)
        bar.add_css_class("bar")
        self.prompt = Gtk.Label(label="hostd >")
        self.prompt.add_css_class("prompt")
        self.entry = Gtk.Text(hexpand=True, placeholder_text="filter")
        self.entry.connect("changed", lambda *_: self.filter_changed())
        self.count = Gtk.Label()
        self.count.add_css_class("count")
        for w in (self.prompt, self.entry, self.count):
            bar.append(w)

        self.list = self._list()
        clicks = Gtk.GestureClick(button=3)  # right click: the entry's actions
        clicks.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)  # before the list takes the press
        clicks.connect("pressed", self.on_right_click)
        self.list.add_controller(clicks)
        self.scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.scroll.set_child(self.list)

        # An entry's actions: a small box at the entry, over the list.
        self.actions = self._list(filtered=False)
        self.popover = Gtk.Popover(has_arrow=False, autohide=True, position=Gtk.PositionType.BOTTOM)
        self.popover.add_css_class("actions")
        self.popover.set_child(self.actions)
        self.popover.connect("closed", lambda *_: self.actions_closed())
        actions_keys = Gtk.EventControllerKey()  # the box is a surface of its own
        actions_keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        actions_keys.connect("key-pressed", lambda _c, keyval, _code, _state: self.on_actions_key(keyval))
        self.popover.add_controller(actions_keys)

        self.status = Gtk.Label(xalign=0)
        self.status.add_css_class("status")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        for w in (bar, self.scroll, self.status):
            box.append(w)
        self.set_child(box)
        # Attached to the layout box, which is never emptied (the list is,
        # on every refresh, and must not take the box with it).
        self.box = box
        self.popover.set_parent(box)

        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        # Coming back to the front: list again. Not while actions are open: they
        # takes the focus itself, and the window turns active again behind it.
        self.connect("notify::is-active", lambda *_: self.is_active() and self.actions_for is None and self.refresh())
        self.controllers = Controllers(self.on_nav)
        self.fullscreen()
        self.refresh()
        # While in front, follow changes (an app closed with Super+Q, one
        # started from a phone) without losing the filter or selection:
        # from hostd's events, or, while that stream is down, by asking
        # every few seconds.
        self.pending = False
        self.events = EventStream(api, self.on_event)
        self.events.start()
        GLib.timeout_add_seconds(5, self.poll)

    def _list(self, filtered=True):
        lst = Gtk.ListBox(selection_mode=Gtk.SelectionMode.BROWSE, activate_on_single_click=True)
        if filtered:
            lst.set_filter_func(self.visible)
        lst.connect("row-activated", lambda _l, row: self.open(row))  # left click, Enter, A
        return lst

    # --- content ---

    def _row(self, lst, cells, action=None, header=False, instance=None, app=None):
        row = Gtk.ListBoxRow(selectable=not header, activatable=not header)
        box = Gtk.Box(spacing=16)
        for text, cls, expand in cells:
            label = Gtk.Label(label=text, xalign=0, hexpand=expand, ellipsize=3)  # 3: end
            label.add_css_class(cls)
            box.append(label)
        row.set_child(box)
        row.action = action  # (method, path, body)
        row.instance = instance  # running rows: what Delete closes
        row.app = app
        row.title = cells[1][0] if len(cells) > 1 else ""
        row.header = header
        row.key = " ".join(c[0] for c in cells).lower()
        if header:
            row.add_css_class("header")
        lst.append(row)

    def current(self):
        return self.actions if self.actions_for is not None else self.list

    def fetch(self):
        try:
            instances = self.api.call("GET", "/v1/instances") or []
            apps = (self.api.call("GET", "/v1/apps") or {}).get("apps", [])
        except Exception as e:  # noqa: BLE001 - shown to the person
            self.show_status(f"cannot reach hostd: {e}", error=True)
            return None
        return instances, apps

    def on_event(self, ev):
        """An event from hostd: list again (once per burst) if it can
        change the list."""
        kind = ev.get("type", "")
        if kind.startswith(("instance.", "app.", "hostd.", "bus.")) and not self.pending:
            self.pending = True
            GLib.timeout_add(100, self.update)
        return False  # an idle callback runs once

    def update(self):
        self.pending = False
        if self.is_active() and self.actions_for is None:
            data = self.fetch()
            if data is not None and json.dumps(data, sort_keys=True) != self.shown:
                self.refresh(data, keep=True)
        return False

    def poll(self):
        if self.events.connected:
            return True  # the event stream keeps the list current
        if self.is_active() and self.actions_for is None:
            data = self.fetch()
            if data is not None and json.dumps(data, sort_keys=True) != self.shown:
                self.refresh(data, keep=True)
        return True  # keep polling

    def refresh(self, data=None, keep=False):
        """Lists again. keep: leave the filter and the selection as they are."""
        data = data or self.fetch()
        if data is None:
            return
        instances, apps = data
        self.shown = json.dumps(data, sort_keys=True)
        selected = self.list.get_selected_row()
        selected = (selected.instance, selected.app) if keep and selected is not None else None
        text = self.entry.get_text() if keep else ""
        self.close_actions()
        self.apps = {a["id"]: a for a in apps}
        self.list.remove_all()
        running = [i for i in instances
                   if i.get("app") != APP_ID and i.get("surface") == "window"
                   and i.get("state") in ("starting", "running")]
        listed = [a for a in apps if a["id"] != APP_ID and a.get("surface") == "window"]
        self._row(self.list, [("running", "id", True)], header=True)
        for inst in running:
            self._row(self.list, [("*", "mark", False), (inst.get("name") or inst["id"], "name", False),
                                  (inst["id"], "id", True), (inst.get("action") or inst.get("state", ""), "meta", False)],
                      ("POST", f"/v1/windows/{inst['id']}/focus", None), instance=inst["id"], app=inst.get("app"))
        self._row(self.list, [("apps", "id", True)], header=True)
        for app in listed:
            n = len(app.get("actions") or [])
            more = f"{n} action{'s' if n > 1 else ''}  " if n else ""  # in its actions box
            self._row(self.list, [(" ", "mark", False), (app.get("name") or app["id"], "name", False),
                                  (app["id"], "id", True), (more + app.get("runner", {}).get("type", ""), "meta", False)],
                      ("POST", f"/v1/apps/{app['id']}/start", None), app=app["id"])
        self.count.set_text(f"{len(running)} running  {len(listed)} apps")
        self.entry.set_text(text)
        self.filter_changed()
        if selected is not None:
            for row in self.rows():
                if (row.instance, row.app) == selected:
                    self.list.select_row(row)
                    break
        if not keep:
            self.entry.grab_focus()
            self.show_status(self.HINT)

    # --- an entry's actions ---

    def open_actions(self, row, x=None):
        """Opens the entry's actions just below it (at x, for a click)."""
        if row is None or row.header:
            return
        self.actions.remove_all()
        app = self.apps.get(row.app) or {}
        if row.instance:
            self._row(self.actions, [(" ", "mark", False), ("focus", "name", True)], row.action)
            self._row(self.actions, [(" ", "mark", False), ("close", "name", True)],
                      ("POST", f"/v1/windows/{row.instance}/close", None))
        else:
            self._row(self.actions, [(" ", "mark", False), ("start", "name", True)], row.action)
        for act in app.get("actions") or []:
            self._row(self.actions, [("+", "mark", False), (act["name"], "name", True), (act["id"], "id", False)],
                      ("POST", f"/v1/apps/{app['id']}/start", {"action": act["id"]}))
        # No focus inside the box: its keys are the window's (on_key), so
        # nothing else moves the selection or runs an entry too.
        entry = self.actions.get_first_child()
        while entry is not None:
            entry.set_focusable(False)
            entry = entry.get_next_sibling()
        self.actions.set_focusable(False)
        self.actions_for = row
        ok, bounds = row.compute_bounds(self.box)
        rect = Gdk.Rectangle()
        rect.x = int(x) if x is not None else 48
        rect.y = int(bounds.get_y()) if ok else 0
        rect.width, rect.height = 1, int(bounds.get_height()) if ok else 1
        self.popover.set_pointing_to(rect)
        self.popover.popup()
        self.actions.select_row(self.actions.get_row_at_index(0))
        self.show_status(self.ACTIONS_HINT)

    def close_actions(self):
        if self.actions_for is not None:
            self.popover.popdown()  # actions_closed() follows

    def actions_closed(self):
        row, self.actions_for = self.actions_for, None
        if row is not None and row.get_parent() is self.list:
            self.list.select_row(row)
        self.entry.grab_focus()
        self.show_status(self.HINT)

    def on_right_click(self, _gesture, _n, x, y):
        row = self.list.get_row_at_y(int(y))
        if row is not None and not row.header:
            self.list.select_row(row)
            self.open_actions(row, x)

    # --- filtering and moving ---

    def visible(self, row):
        text = self.entry.get_text().strip().lower()
        if not text:
            return True
        return not row.header and all(w in row.key for w in text.split())

    def filter_changed(self):
        self.current().invalidate_filter()
        self.select_first()

    def rows(self):
        lst = self.current()
        out, row = [], lst.get_first_child()
        while row is not None:
            if isinstance(row, Gtk.ListBoxRow) and not row.header and (lst is self.actions or self.visible(row)):
                out.append(row)
            row = row.get_next_sibling()
        return out

    def select_first(self):
        rows = self.rows()
        self.current().select_row(rows[0] if rows else None)

    def move(self, step):
        rows = self.rows()
        if not rows:
            return
        lst = self.current()
        cur = lst.get_selected_row()
        i = rows.index(cur) + step if cur in rows else 0
        row = rows[max(0, min(len(rows) - 1, i))]
        lst.select_row(row)
        if lst is self.list:
            row.grab_focus()  # scrolls it into view
            self.entry.grab_focus()  # typing keeps filtering

    # --- actions ---

    def show_status(self, text, error=False):
        self.status.set_text(text)
        if error:
            self.status.add_css_class("error")
        else:
            self.status.remove_css_class("error")

    def call(self, method, path, body=None):
        """Sends an action; reports a failure or a skip in the status line."""
        try:
            res = self.api.call(method, path, body) or {}
        except Exception as e:  # noqa: BLE001
            self.show_status(f"error: {e}", error=True)
            return None
        if res.get("status") == "skipped":
            self.show_status("skipped: " + (res.get("reason") or ""), error=True)
        return res

    def open(self, row):
        """Runs a row's action: in the list, open the app; in the actions box, the entry."""
        if row is None or row.action is None:
            return
        in_actions = self.actions_for is not None
        if in_actions:
            self.close_actions()
        res = self.call(*row.action)
        if in_actions and res is not None:
            self.refresh(keep=True)  # the list may have changed

    def back(self):
        if self.actions_for is not None:
            self.close_actions()
        elif self.entry.get_text():
            self.entry.set_text("")
        else:
            self.call("POST", "/v1/windows/back")

    def close(self, row):
        """Closes a running app (its row's instance), then lists again."""
        if row is None or row.instance is None:
            return
        if self.call("POST", f"/v1/windows/{row.instance}/close") is not None:
            self.refresh()

    def on_key(self, _ctl, keyval, _code, state):
        name = Gdk.keyval_name(keyval)
        shift = bool(state & Gdk.ModifierType.SHIFT_MASK)
        if self.actions_for is not None:
            return self.on_actions_key(keyval)
        if name == "Escape":
            self.back()
        elif name in ("Down", "Tab"):
            self.move(1)
        elif name in ("Up", "ISO_Left_Tab"):
            self.move(-1)
        elif name in ("Page_Down", "Page_Up"):
            self.move(10 if name == "Page_Down" else -10)
        elif name in ("Return", "KP_Enter"):
            self.open(self.current().get_selected_row())
        elif name == "Menu" or (name == "F10" and shift):
            if self.actions_for is None:
                self.open_actions(self.list.get_selected_row())
        elif name == "Delete":
            self.close(self.list.get_selected_row())
        else:
            return False
        return True

    def on_actions_key(self, keyval):
        """Keys while actions are open. Their rows take no focus, so these are
        the only ones that move the selection or run an entry."""
        name = Gdk.keyval_name(keyval)
        if name in ("Escape", "Menu"):
            self.close_actions()
        elif name in ("Down", "Tab"):
            self.move(1)
        elif name in ("Up", "ISO_Left_Tab"):
            self.move(-1)
        elif name in ("Return", "KP_Enter"):
            self.open(self.actions.get_selected_row())
        return True

    def on_nav(self, what):
        if not self.is_active():
            return
        if what == "back":
            self.back()
        elif what == "choose":
            self.open(self.current().get_selected_row())
        elif what == "actions":
            if self.actions_for is None:
                self.open_actions(self.list.get_selected_row())
        elif what in ("up", "left"):
            self.move(-1)
        else:
            self.move(1)


def main():
    api = API()
    if not api.token:
        print("hostd-menu: no token: set HOSTD_TOKEN or create ~/.config/hostd/local.token", file=sys.stderr)
    app = Gtk.Application(application_id="org.hostd.Menu")

    def activate(application):
        provider = Gtk.CssProvider()
        if hasattr(provider, "load_from_string"):  # GTK 4.12+
            provider.load_from_string(CSS)
        else:
            provider.load_from_data(CSS, -1)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = application.get_active_window() or Menu(application, api)
        win.present()

    app.connect("activate", activate)
    return app.run(None)


if __name__ == "__main__":
    sys.exit(main())
