# Managed by hostd-setup; changes here are overwritten.

# --- design tokens (generated by scripts/uitokens; edit deploy/files/ui/tokens.toml) ---
output * bg #0b0b0c solid_color
# --- end of design tokens ---
default_border none
default_floating_border none
focus_follows_mouse no
# The mouse pointer is for people at the screen: it hides after 2 seconds without use
# (a projector or TV does not need one on show, and a remote screen's own pointer is
# the one to watch), and comes back when the mouse moves.
seat * hide_cursor 2000

# Make the session's variables visible to systemd user units and D-Bus
# activation, so apps that hostd starts can reach Wayland, Sway and
# Xwayland (DISPLAY: X11 apps such as Steam need it). On every reload too,
# so an update applies it without a new login. Then start the session's
# user services, which need those variables: hostd's notices and OSD
# (drawn above fullscreen apps), and VNC.
exec_always dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE && systemctl --user restart hostd-notices.service wayvnc.service

# Keys are hostd's: it installs its bindings at runtime and runs an action
# for each (Super: menu, Super+Tab / Super+Shift+Tab: next / previous
# app, Super+Q: close the app). See [input] in hostd.toml.
