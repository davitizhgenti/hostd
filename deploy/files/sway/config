# Managed by hostd deploy/install.sh; changes here are overwritten.

output * bg #1d2430 solid_color
default_border none
default_floating_border none
focus_follows_mouse no

# Make the session's variables visible to systemd user units, so apps that
# hostd starts as transient services can reach Wayland and Sway.
exec systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP

# On-screen notices, and VNC for watching the screen remotely. VNC listens on
# localhost only; reach it with an SSH tunnel (ssh -L 5900:127.0.0.1:5900).
exec mako
exec wayvnc 127.0.0.1 5900

set $mod Mod4
bindsym $mod+Return exec foot
bindsym $mod+Shift+q kill
