# Managed by hostd deploy/install.sh; changes here are overwritten.

output * bg #1d2430 solid_color
default_border none
default_floating_border none
focus_follows_mouse no

# Make the session's variables visible to systemd user units, so apps that
# hostd starts as transient services can reach Wayland and Sway. Then start
# the session's user services (VNC), which need those variables.
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE && systemctl --user restart wayvnc.service

# On-screen notices.
exec mako

set $mod Mod4
bindsym $mod+Shift+q kill

# Step through the apps (each has its own workspace).
bindsym $mod+Tab workspace next_on_output
bindsym $mod+Shift+Tab workspace prev_on_output

# Super alone opens hostd's switcher (or goes back from it); a controller's
# Guide button does the same through hostd.
bindsym --release Super_L exec hostd-switch
