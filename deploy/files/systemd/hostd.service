# Managed by hostd-setup; changes here are overwritten.
#
# hostd runs as the screen user, started at boot thanks to lingering.
# Type=notify: the unit is "started" only once hostd is serving its API.
[Unit]
Description=hostd, the display and services daemon
Documentation=https://github.com/davitizhgenti/hostd
# Three failed starts within two minutes (a crash, or no READY within
# TimeoutStartSec) put the unit in "failed", which starts the rollback.
StartLimitIntervalSec=120
StartLimitBurst=3
OnFailure=hostd-rollback.service

[Service]
Type=notify
ExecStart=%h/.local/lib/hostd/current/hostd
# hostctl, hostd-setup and the add-ons' commands live in ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
# Apps run in their own units, so stopping hostd never stops them.
KillMode=mixed

[Install]
WantedBy=default.target
