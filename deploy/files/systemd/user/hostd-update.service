# Managed by hostd-setup; changes here are overwritten.
#
# Looks for a new signed hostd build and applies it, announces it or
# leaves it, as ~/.config/hostd/update.conf says.
[Unit]
Description=Look for a new hostd build
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/hostd-setup auto-update
