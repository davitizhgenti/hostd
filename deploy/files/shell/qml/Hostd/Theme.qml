// hostd's design tokens. Generated by scripts/uitokens from
// deploy/files/shell/tokens.toml: edit that, then go generate ./deploy.
pragma Singleton
import QtQuick

QtObject {
    // Sizes are for a 1080-pixel-high screen; the shell sets the scale.
    property real scale: 1.0
    // The screen's width in px, set by the shell: the menu is centred on it.
    property int screenWidth: 1920
    // Every duration is multiplied by this: tests set 0, so nothing moves.
    property real animate: 1.0

    // color
    readonly property color colorBg: "#0b0b0c"
    readonly property color colorSurface: "#141416"
    readonly property color colorSurfaceRaised: "#1b1b1e"
    readonly property color colorBorder: "#2a2a2e"
    readonly property color colorText: "#f2f2f4"
    readonly property color colorTextMuted: "#9e9ea6"
    readonly property color colorAccent: "#f2f2f4"
    readonly property color colorPositive: "#8cc4a2"
    readonly property color colorWarning: "#dcb872"
    readonly property color colorDanger: "#e07e7e"

    // font
    readonly property string fontText: "Inter"
    readonly property string fontMono: "DejaVu Sans Mono"

    // type
    readonly property int typeDisplay: Math.max(1, Math.round(56 * scale))
    readonly property int typeTitle: Math.max(1, Math.round(36 * scale))
    readonly property int typeBody: Math.max(1, Math.round(26 * scale))
    readonly property int typeLabel: Math.max(1, Math.round(20 * scale))

    // weight
    readonly property int weightLight: 300
    readonly property int weightRegular: 400
    readonly property int weightStrong: 500

    // space
    readonly property int spaceXs: Math.max(1, Math.round(4 * scale))
    readonly property int spaceS: Math.max(1, Math.round(8 * scale))
    readonly property int spaceM: Math.max(1, Math.round(16 * scale))
    readonly property int spaceL: Math.max(1, Math.round(24 * scale))
    readonly property int spaceXl: Math.max(1, Math.round(32 * scale))
    readonly property int spaceXxl: Math.max(1, Math.round(48 * scale))
    readonly property int spaceXxxl: Math.max(1, Math.round(64 * scale))

    // line
    readonly property int lineHair: Math.max(1, Math.round(1 * scale))
    readonly property int lineFocus: Math.max(1, Math.round(2 * scale))

    // motion
    readonly property int motionFast: Math.round(120 * animate)
    readonly property int motionBase: Math.round(220 * animate)

    // layout
    readonly property int layoutSafeMargin: Math.max(1, Math.round(48 * scale))
    readonly property int layoutCrossY: Math.max(1, Math.round(288 * scale))
    readonly property int layoutColumnWidth: Math.max(1, Math.round(1040 * scale))
    readonly property int layoutCategoryStep: Math.max(1, Math.round(184 * scale))
    readonly property int layoutIconCategory: Math.max(1, Math.round(64 * scale))
    readonly property int layoutIconItem: Math.max(1, Math.round(40 * scale))
    readonly property int layoutIconSmall: Math.max(1, Math.round(24 * scale))
    readonly property int layoutItemHeight: Math.max(1, Math.round(96 * scale))
    readonly property int layoutItemLine: Math.max(1, Math.round(64 * scale))
    readonly property int layoutSection: Math.max(1, Math.round(56 * scale))
    readonly property int layoutPanelWidth: Math.max(1, Math.round(640 * scale))
    readonly property int layoutNoticeWidth: Math.max(1, Math.round(600 * scale))
    readonly property int layoutOsdWidth: Math.max(1, Math.round(440 * scale))
    readonly property int layoutTile: Math.max(1, Math.round(320 * scale))
    readonly property int layoutTileSmall: Math.max(1, Math.round(160 * scale))

    // input
    readonly property int inputGlideStep: 40
    readonly property int inputGlideCross: 100
    readonly property int inputGlideRest: 250
    readonly property int inputGlideFloor: 60
    readonly property int inputGlideBurst: 3

    // month
    readonly property color monthJan: "#9097a3"
    readonly property color monthFeb: "#b39a4f"
    readonly property color monthMar: "#7f9c5c"
    readonly property color monthApr: "#c48aa4"
    readonly property color monthMay: "#5ea06f"
    readonly property color monthJun: "#8d78b4"
    readonly property color monthJul: "#4e9f9b"
    readonly property color monthAug: "#4f80c2"
    readonly property color monthSep: "#7462aa"
    readonly property color monthOct: "#c48a3e"
    readonly property color monthNov: "#8d6a4e"
    readonly property color monthDec: "#b2484f"
}
