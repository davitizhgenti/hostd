#!/usr/bin/python3
"""hostd's on-screen switcher.

A fullscreen, filterable list of the running apps and the catalog. hostd runs it as the
hidden app "hostd-overlay"; Super (Sway) and a controller's Guide button
(hostd) bring it forward. Choosing an entry sends window.focus or app.start
with the "local" token, so it counts as someone at the screen.

Keyboard: type to filter, up/down, Enter, Delete (close), Escape. Controller:
D-pad, A, B. Going back and closing are hostd actions, like everything that
changes the screen.
Needs python3-gi and gir1.2-gtk-4.0; talks to hostd over its unix socket.
"""

import http.client
import json
import os
import socket
import struct
import sys

import gi

os.environ.setdefault("GTK_A11Y", "none")  # no accessibility bus on a TV session

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

APP_ID = "hostd-overlay"  # its own entry in hostd's catalog, never listed

CSS = """
* { font-family: "DejaVu Sans Mono", monospace; font-size: 15px; border-radius: 0; box-shadow: none; }
window { background: #0e1116; color: #c9d1d9; }
.bar { padding: 14px 24px; border-bottom: 1px solid #262c36; }
.prompt { color: #58a6ff; font-weight: bold; margin-right: 10px; }
entry { background: transparent; border: none; outline: none; color: #e6edf3; min-height: 0; padding: 0; caret-color: #58a6ff; }
.count { color: #6e7681; }
list { background: transparent; padding: 8px 0; }
row { padding: 3px 24px; border-left: 2px solid transparent; }
row:selected, row:focus { background: #161b22; border-left-color: #58a6ff; outline: none; }
row.header { padding: 12px 24px 4px 24px; }
row.header label { color: #6e7681; }
.mark { color: #3fb950; min-width: 12px; }
.name { color: #e6edf3; }
.id, .meta { color: #6e7681; }
.status { padding: 8px 24px; border-top: 1px solid #262c36; color: #6e7681; }
.status.error { color: #f85149; }
"""


# --- hostd API ----------------------------------------------------------------


class UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, path, timeout=10):
        super().__init__("hostd", timeout=timeout)
        self.path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.path)


class API:
    def __init__(self):
        runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        self.socket = os.environ.get("HOSTD_SOCKET", os.path.join(runtime, "hostd.sock"))
        self.token = os.environ.get("HOSTD_TOKEN") or self._token_file()

    @staticmethod
    def _token_file():
        config = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
        try:
            with open(os.path.join(config, "hostd", "local.token")) as f:
                return f.read().strip()
        except OSError:
            return ""

    def call(self, method, path, body=None):
        conn = UnixHTTPConnection(self.socket)
        try:
            headers = {"Authorization": "Bearer " + self.token}
            data = None
            if body is not None:
                data = json.dumps(body).encode()
                headers["Content-Type"] = "application/json"
            conn.request(method, path, body=data, headers=headers)
            resp = conn.getresponse()
            payload = json.loads(resp.read() or b"null")
            if resp.status >= 400:
                err = (payload or {}).get("error", {})
                raise RuntimeError(err.get("message") or f"HTTP {resp.status}")
            return payload
        finally:
            conn.close()


# --- controller input -----------------------------------------------------------

EV_KEY, EV_ABS = 0x01, 0x03
ABS_HAT0X, ABS_HAT0Y = 0x10, 0x11
BTN_SOUTH, BTN_EAST = 0x130, 0x131  # A, B
BTN_DPAD = {0x220: "up", 0x221: "down", 0x222: "left", 0x223: "right"}
EVENT = struct.Struct("llHHi")  # struct input_event on 64-bit Linux


class Controllers:
    """Reads gamepads from /dev/input and reports navigation."""

    def __init__(self, on_nav):
        self.on_nav = on_nav
        self.open = {}  # path -> (fd, watch id)
        self.rescan()
        GLib.timeout_add_seconds(3, self.rescan)

    def rescan(self):
        try:
            names = os.listdir("/dev/input")
        except OSError:
            return True
        for name in names:
            path = os.path.join("/dev/input", name)
            if not name.startswith("event") or path in self.open:
                continue
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                continue
            watch = GLib.io_add_watch(fd, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.read, path)
            self.open[path] = (fd, watch)
        return True

    def read(self, fd, cond, path):
        try:
            data = os.read(fd, EVENT.size * 64)
        except BlockingIOError:
            return True
        except OSError:
            data = b""
        if not data:  # unplugged
            os.close(fd)
            self.open.pop(path, None)
            return False
        for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
            _, _, typ, code, value = EVENT.unpack_from(data, i)
            if typ == EV_KEY and value == 1:
                if code == BTN_SOUTH:
                    self.on_nav("choose")
                elif code == BTN_EAST:
                    self.on_nav("back")
                elif code in BTN_DPAD:
                    self.on_nav(BTN_DPAD[code])
            elif typ == EV_ABS and code in (ABS_HAT0X, ABS_HAT0Y) and value != 0:
                if code == ABS_HAT0X:
                    self.on_nav("left" if value < 0 else "right")
                else:
                    self.on_nav("up" if value < 0 else "down")
        return True


# --- the window -----------------------------------------------------------------


class Switcher(Gtk.ApplicationWindow):
    """One filterable list: running instances, then the catalog."""

    def __init__(self, app, api):
        super().__init__(application=app, title="hostd")
        self.api = api
        self.set_decorated(False)

        bar = Gtk.Box(spacing=0)
        bar.add_css_class("bar")
        prompt = Gtk.Label(label="hostd >")
        prompt.add_css_class("prompt")
        self.entry = Gtk.Text(hexpand=True, placeholder_text="filter")
        self.entry.connect("changed", lambda *_: self.filter_changed())
        self.count = Gtk.Label()
        self.count.add_css_class("count")
        for w in (prompt, self.entry, self.count):
            bar.append(w)

        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.BROWSE)
        self.list.set_filter_func(self.visible)
        self.list.connect("row-activated", lambda _l, row: self.open(row))
        scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.set_child(self.list)

        self.status = Gtk.Label(xalign=0)
        self.status.add_css_class("status")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        for w in (bar, scroll, self.status):
            box.append(w)
        self.set_child(box)

        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        self.connect("notify::is-active", lambda *_: self.is_active() and self.refresh())
        self.controllers = Controllers(self.on_nav)
        self.fullscreen()
        self.refresh()

    # --- content ---

    def _row(self, cells, action=None, header=False, instance=None):
        row = Gtk.ListBoxRow(selectable=not header, activatable=not header)
        box = Gtk.Box(spacing=16)
        for text, cls, expand in cells:
            label = Gtk.Label(label=text, xalign=0, hexpand=expand, ellipsize=3)  # 3: end
            label.add_css_class(cls)
            box.append(label)
        row.set_child(box)
        row.action = action
        row.instance = instance  # running rows: what Delete closes
        row.header = header
        row.key = " ".join(c[0] for c in cells).lower()
        if header:
            row.add_css_class("header")
        self.list.append(row)

    def refresh(self):
        try:
            instances = self.api.call("GET", "/v1/instances") or []
            apps = (self.api.call("GET", "/v1/apps") or {}).get("apps", [])
        except Exception as e:  # noqa: BLE001 - shown to the person
            self.show_status(f"cannot reach hostd: {e}", error=True)
            return
        self.list.remove_all()
        running = [i for i in instances
                   if i.get("app") != APP_ID and i.get("surface") == "window"
                   and i.get("state") in ("starting", "running")]
        listed = [a for a in apps if a["id"] != APP_ID and a.get("surface") == "window"]
        self._row([("running", "id", True)], header=True)
        for inst in running:
            self._row([("*", "mark", False), (inst.get("name") or inst["id"], "name", False),
                       (inst["id"], "id", True), (inst.get("state", ""), "meta", False)],
                      ("POST", f"/v1/windows/{inst['id']}/focus"), instance=inst["id"])
        self._row([("apps", "id", True)], header=True)
        for app in listed:
            self._row([(" ", "mark", False), (app.get("name") or app["id"], "name", False),
                       (app["id"], "id", True), (app.get("runner", {}).get("type", ""), "meta", False)],
                      ("POST", f"/v1/apps/{app['id']}/start"))
        self.count.set_text(f"{len(running)} running  {len(listed)} apps")
        self.entry.set_text("")
        self.filter_changed()
        self.entry.grab_focus()
        self.show_status("up/down move  enter open  del close  esc back  type to filter")

    def visible(self, row):
        text = self.entry.get_text().strip().lower()
        if not text:
            return True
        return not row.header and all(w in row.key for w in text.split())

    def filter_changed(self):
        self.list.invalidate_filter()
        self.select_first()

    def rows(self):
        out, row = [], self.list.get_first_child()
        while row is not None:
            if isinstance(row, Gtk.ListBoxRow) and not row.header and row.get_child_visible() and self.visible(row):
                out.append(row)
            row = row.get_next_sibling()
        return out

    def select_first(self):
        rows = self.rows()
        self.list.select_row(rows[0] if rows else None)

    def move(self, step):
        rows = self.rows()
        if not rows:
            return
        cur = self.list.get_selected_row()
        i = rows.index(cur) + step if cur in rows else 0
        row = rows[max(0, min(len(rows) - 1, i))]
        self.list.select_row(row)
        row.grab_focus()
        self.entry.grab_focus()  # typing keeps filtering

    # --- actions ---

    def show_status(self, text, error=False):
        self.status.set_text(text)
        if error:
            self.status.add_css_class("error")
        else:
            self.status.remove_css_class("error")

    def call(self, method, path):
        """Sends an action; reports a failure or a skip in the status line."""
        try:
            res = self.api.call(method, path) or {}
        except Exception as e:  # noqa: BLE001
            self.show_status(f"error: {e}", error=True)
            return None
        if res.get("status") == "skipped":
            self.show_status("skipped: " + (res.get("reason") or ""), error=True)
        return res

    def open(self, row):
        if row is not None and row.action is not None:
            self.call(*row.action)

    def back(self):
        self.call("POST", "/v1/windows/back")

    def close(self, row):
        """Closes a running app (its row's instance), then lists again."""
        if row is None or row.instance is None:
            return
        if self.call("POST", f"/v1/windows/{row.instance}/close") is not None:
            self.refresh()

    def on_key(self, _ctl, keyval, _code, _state):
        name = Gdk.keyval_name(keyval)
        if name == "Escape":
            if self.entry.get_text():
                self.entry.set_text("")
            else:
                self.back()
        elif name in ("Down", "Tab"):
            self.move(1)
        elif name in ("Up", "ISO_Left_Tab"):
            self.move(-1)
        elif name in ("Page_Down", "Page_Up"):
            self.move(10 if name == "Page_Down" else -10)
        elif name in ("Return", "KP_Enter"):
            self.open(self.list.get_selected_row())
        elif name == "Delete":
            self.close(self.list.get_selected_row())
        else:
            return False
        return True

    def on_nav(self, what):
        if not self.is_active():
            return
        if what == "back":
            self.back()
        elif what == "choose":
            self.open(self.list.get_selected_row())
        elif what in ("up", "left"):
            self.move(-1)
        else:
            self.move(1)


def main():
    api = API()
    if not api.token:
        print("hostd-overlay: no token: set HOSTD_TOKEN or create ~/.config/hostd/local.token", file=sys.stderr)
    app = Gtk.Application(application_id="org.hostd.Switcher")

    def activate(application):
        provider = Gtk.CssProvider()
        if hasattr(provider, "load_from_string"):  # GTK 4.12+
            provider.load_from_string(CSS)
        else:
            provider.load_from_data(CSS, -1)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = application.get_active_window() or Switcher(application, api)
        win.present()

    app.connect("activate", activate)
    return app.run(None)


if __name__ == "__main__":
    sys.exit(main())
