#!/usr/bin/python3
"""hostd's menu: the full-screen UI on the monitor, laid out as a cross.

The categories (Apps, Users, Settings, Status) run left and right on one
row; the current one's items run up and down through it, the current item
large, as on the PSP. Options for an item come in at the right edge.
hostd runs it as the hidden app "hostd-menu" and brings it forward with
display.menu (Super, or holding a controller's Guide button).

Every input does the same thing (hostd_ui.input): left and right change
the category, up and down the item, Enter or A chooses, Esc or B goes back,
Menu or X opens the options; typing filters the Apps. Controllers arrive as
hostd's display.nav events. Choices are sent with the local token, so they
count as someone at the screen. The background is this screen's own
setting (hostd_ui.background), changed under Settings.

Needs python3-gi and gir1.2-gtk-4.0; talks to hostd over its unix socket.
"""

import datetime
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
os.environ.setdefault("GTK_A11Y", "none")  # no accessibility bus on a TV session

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

from hostd_ui import api as hapi  # noqa: E402
from hostd_ui import background, cross, theme, views  # noqa: E402
from hostd_ui import components as ui  # noqa: E402
from hostd_ui import input as inp  # noqa: E402

APPS, USERS, SETTINGS, STATUS = range(len(views.CATEGORIES))
# Events after which a category lists again.
REFRESH_ON = {
    APPS: ("instance.", "app.", "hostd.", "bus."),
    USERS: ("seat.", "hostd."),
    SETTINGS: ("audio.", "display.output", "display.mode", "display.power", "hostd."),
    STATUS: ("hostd.",),
}
GAP = 16  # px at 1080: between the category row and its items


def fetch(api, page, look, tokens):
    """The category's rows and its summary line, from hostd."""
    if page == APPS:
        instances = api.get("/v1/instances") or []
        apps = [it["spec"] for it in (api.get("/v1/apps") or []) if it.get("spec")]
        return views.apps_page(instances, apps)
    if page == USERS:
        try:
            seats = api.get("/v1/seat")
        except hapi.APIError as e:
            if e.status != 404:
                raise
            return [views.Row("Switching users is not set up", icon="info",
                              subtitle="the seats add-on: sudo hostd-admin add seats")], ""
        return views.users_page(seats), ""
    if page == SETTINGS:
        try:
            audio = api.get("/v1/audio")
        except hapi.APIError:
            audio = None
        return views.settings_page(audio, api.get("/v1/display"), look, tokens), ""
    return views.status_page(api.get("/v1/version"), api.get("/v1/display"), api.get("/v1/actions?limit=12")), ""


def corner(halign, valign, *children, vertical=True):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL if vertical else Gtk.Orientation.HORIZONTAL,
                  halign=halign, valign=valign)
    box.add_css_class("corner")
    for c in children:
        box.append(c)
    return box


class Menu(Gtk.ApplicationWindow):
    def __init__(self, app, api, size):
        super().__init__(application=app, title="hostd")
        self.add_css_class("hostd")
        self.set_decorated(False)
        self.api = api
        self.tokens = theme.tokens()
        self.look = background.load()
        self.page = APPS
        self.rows, self.shown_rows = [], []
        self.shown = ""  # what the category shows, to notice changes
        self.asked = None  # the call the band asks about
        self.device = "keys"  # the input used last: its buttons are the hints
        self.pending = False

        width, height = size
        scale = theme.scale_for(height)
        layout, color = self.tokens["layout"], self.tokens["color"]["text"]
        metrics = cross.Metrics.of(layout, scale, GAP, self.tokens["type"]["title"] * 1.5)
        icon_item = round(layout["icon-item"] * scale)

        self.backdrop = Gtk.Box(hexpand=True, vexpand=True)
        self.backdrop.add_css_class("backdrop")
        self.bg = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(self.get_display(), self.bg,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)

        self.cross = ui.Cross(metrics, width, icon_item, color, self.tokens["motion"]["base"])
        self.cross.set_categories(views.CATEGORIES)
        self.cross.on_click = self.on_item_click
        self.cross.on_category = lambda i: self.show_page(i)

        self.filter = Gtk.Text(placeholder_text="Type to filter")
        self.filter.add_css_class("filter")
        self.filter.connect("changed", lambda *_: self.show_rows(keep=False))
        self.clock = ui.label("", "clock", xalign=1.0)
        self.summary = ui.label("", "summary", xalign=1.0)
        self.message = ui.label("", "message")
        self.hints = ui.label("", "hints", xalign=1.0)

        self.scrim = Gtk.Box(hexpand=True, vexpand=True, visible=False)
        self.scrim.add_css_class("scrim")
        self.panel = ui.OptionsPanel(round(layout["panel-width"] * scale), icon_item, color)
        self.band = ui.ConfirmBand()

        overlay = Gtk.Overlay(child=self.backdrop)
        for w in (self.cross,
                  corner(Gtk.Align.START, Gtk.Align.START, self.filter),
                  corner(Gtk.Align.END, Gtk.Align.START, self.clock, self.summary),
                  corner(Gtk.Align.START, Gtk.Align.END, self.message),
                  self.scrim, self.panel, self.band,
                  corner(Gtk.Align.END, Gtk.Align.END, self.hints)):  # the hints over everything
            overlay.add_overlay(w)
        self.set_child(overlay)

        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        right = Gtk.GestureClick(button=3)  # right click: the options
        right.connect("pressed", lambda *_: self.open_options(self.selected()))
        self.add_controller(right)
        wheel = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL)
        wheel.connect("scroll", lambda _c, _dx, dy: self.handle(inp.DOWN if dy > 0 else inp.UP) or True)
        self.add_controller(wheel)
        # Back in front: list again.
        self.connect("notify::is-active", lambda *_: self.is_active() and self.came_back())
        self.fullscreen()
        self.apply_background()
        self.tick_clock()
        self.show_page(APPS)

        self.events = hapi.EventStream(api, self.on_event, GLib.idle_add)
        self.events.start()
        GLib.timeout_add_seconds(5, self.poll)
        GLib.timeout_add_seconds(20, self.tick_clock)
        GLib.timeout_add_seconds(300, self.apply_background)  # the hour changes the month mode's light

    # --- categories and items ---

    def show_page(self, page, keep=False):
        self.page = page % len(views.CATEGORIES)
        self.cross.set_category(self.page)
        self.filter.set_visible(self.page == APPS)
        if not keep:
            self.filter.set_text("")
        self.close_overlays()
        self.refresh(keep=keep)

    def came_back(self):
        if not self.panel.get_visible() and self.asked is None:
            self.look = background.load()
            self.apply_background()
            self.refresh(keep=True)

    def refresh(self, data=None, keep=False):
        if data is None:
            try:
                data = fetch(self.api, self.page, self.look, self.tokens)
            except Exception as e:  # noqa: BLE001 - shown to the person
                self.say(f"Cannot reach hostd: {e}", error=True)
                return
            self.say("")
        rows, summary = data
        self.shown = json.dumps([r.__dict__ for r in rows], default=str, sort_keys=True)
        self.rows = rows
        self.summary.set_text(summary)
        self.show_rows(keep)
        if self.panel.get_visible() and self.panel.slider:
            key = self.panel.row.key()
            self.panel.update_level(next((r for r in rows if r.key() == key), None))

    def show_rows(self, keep=True):
        cur = self.selected()
        key = cur.key() if keep and cur else None
        self.shown_rows = views.visible(self.rows, self.filter.get_text() if self.page == APPS else "")
        index = next((i for i, r in enumerate(self.shown_rows) if r.key() == key), None)
        if index is None:
            index = self.step_from(-1, 1)
        self.cross.set_items(self.shown_rows, index if index is not None else 0)
        self.update_hints()

    def selected(self):
        w = self.cross.current()
        return w.model if w is not None and w.model.kind != views.HEADER else None

    def step_from(self, index, step):
        """The next item that can be chosen from index, going step; None."""
        i = index + step
        while 0 <= i < len(self.shown_rows):
            if self.shown_rows[i].kind != views.HEADER:
                return i
            i += step
        return None

    def move(self, step):
        i, target = self.cross.selected, None
        for _ in range(abs(step)):
            nxt = self.step_from(i, 1 if step > 0 else -1)
            if nxt is None:
                break
            i = target = nxt
        if target is not None:
            self.cross.select(target)
            self.update_hints()

    def on_item_click(self, item):
        if item is self.cross.current():
            self.choose(item.model)
        else:
            self.cross.select(self.cross.items.index(item))
            self.update_hints()

    # --- what choosing does ---

    def choose(self, row):
        if row is None:
            return
        if row.confirm:
            self.ask(row)
        elif row.kind == views.SLIDER:
            self.open_level(row)
        elif row.call is not None:
            self.send(row.call)
        elif row.sheet:
            self.open_options(row)

    def send(self, call, refresh=True):
        if call.method == "LOCAL":
            return self.local(call)
        try:
            res = self.api.call(call.method, call.path, call.body)
        except Exception as e:  # noqa: BLE001
            self.say(str(e), error=True)
            return None
        self.say(views.result_text(res), error=bool(views.result_text(res)))
        if refresh:
            GLib.timeout_add(150, lambda: self.refresh(keep=True) and False)
        return res

    def local(self, call):
        """A change on this screen alone: the background."""
        if call.path == "background":
            try:
                background.save(call.body)
            except OSError as e:
                self.say(f"Cannot save the background: {e}", error=True)
                return None
            self.look = background.load()
            self.apply_background()
            self.refresh(keep=True)
        return None

    def back(self):
        if self.page == APPS and self.filter.get_text():
            self.filter.set_text("")
        elif self.page != APPS:
            self.show_page(APPS)
        else:
            self.send(views.Call("POST", "/v1/windows/back"), refresh=False)

    # --- the options panel and the question ---

    def open_options(self, row):
        if row is None or not row.sheet:
            return
        self.scrim.set_visible(True)
        self.panel.show_options(row)
        self.update_hints()

    def open_level(self, row):
        self.scrim.set_visible(True)
        self.panel.show_level(row)
        self.update_hints()

    def ask(self, row):
        self.asked = row.call
        self.scrim.set_visible(True)
        self.band.ask(row.confirm)
        self.update_hints()

    def close_overlays(self):
        self.asked = None
        for w in (self.scrim, self.panel, self.band):
            w.set_visible(False)
        self.update_hints()

    # --- input ---

    def on_key(self, _ctl, keyval, _code, state):
        self.device = "keys"
        name = Gdk.keyval_name(keyval) or ""
        typing = self.page == APPS and bool(self.filter.get_text())
        verb = inp.verb_for_key(name, bool(state & Gdk.ModifierType.SHIFT_MASK), typing)
        if verb is None:
            if self.page == APPS and not self.panel.get_visible() and self.asked is None:
                self.filter.grab_focus()
                return False  # typed into the filter
            return True
        if self.page == APPS and typing and verb in (inp.LEFT, inp.RIGHT):
            return False  # moves the filter's cursor
        self.handle(verb)
        return True

    def handle(self, verb):
        if self.asked is not None:
            if verb in (inp.LEFT, inp.RIGHT):
                self.band.choose(verb == inp.RIGHT)
            elif verb == inp.ACTIVATE:
                call, yes = self.asked, self.band.answer
                self.close_overlays()
                if yes:
                    self.send(call)
            elif verb == inp.BACK:
                self.close_overlays()
            return
        if self.panel.get_visible():
            if self.panel.slider:
                row = self.panel.row
                if verb == inp.UP:
                    self.send(row.step)
                elif verb == inp.DOWN:
                    self.send(row.step_back)
                elif verb in (inp.BACK, inp.ACTIVATE, inp.ACTIONS):
                    self.close_overlays()
            elif verb in (inp.UP, inp.DOWN):
                self.panel.move(1 if verb == inp.DOWN else -1)
            elif verb == inp.ACTIVATE:
                row = self.panel.current()
                self.close_overlays()
                self.choose(row)
            elif verb in (inp.BACK, inp.ACTIONS):
                self.close_overlays()
            return
        row = self.selected()
        if verb in (inp.UP, inp.DOWN):
            self.move(1 if verb == inp.DOWN else -1)
        elif verb in (inp.PAGE_UP, inp.PAGE_DOWN):
            self.move(5 if verb == inp.PAGE_DOWN else -5)
        elif verb in (inp.LEFT, inp.PREV_TAB):
            self.show_page(self.page - 1)
        elif verb in (inp.RIGHT, inp.NEXT_TAB):
            self.show_page(self.page + 1)
        elif verb == inp.ACTIVATE:
            self.choose(row)
        elif verb == inp.ACTIONS:
            self.open_options(row)
        elif verb == inp.CLOSE and row is not None and row.instance:
            self.send(views.Call("POST", f"/v1/instances/{row.instance}/close"))
        elif verb == inp.BACK:
            self.back()

    # --- what the screen says ---

    def say(self, text, error=False):
        self.message.set_text(text)
        (self.message.add_css_class if error else self.message.remove_css_class)("error")

    def update_hints(self):
        if self.asked is not None:
            pairs = [(inp.NEXT_TAB, "answer"), (inp.ACTIVATE, "choose"), (inp.BACK, "cancel")]
        elif self.panel.get_visible() and self.panel.slider:
            pairs = [(inp.UP, "change"), (inp.BACK, "done")]
        elif self.panel.get_visible():
            pairs = [(inp.ACTIVATE, "choose"), (inp.BACK, "close")]
        else:
            row = self.selected()
            pairs = []
            if row is not None and (row.call or row.sheet or row.kind == views.SLIDER):
                pairs.append((inp.ACTIVATE, "open" if self.page == APPS else "choose"))
            if row is not None and row.sheet:
                pairs.append((inp.ACTIONS, "options"))
            if row is not None and row.instance:
                pairs.append((inp.CLOSE, "close"))
            pairs.append((inp.NEXT_TAB, "category"))
            pairs.append((inp.BACK, "back"))
        self.hints.set_text(inp.hint_text(pairs, self.device))

    def tick_clock(self):
        self.clock.set_text(datetime.datetime.now().strftime("%a %-d %b   %H:%M"))
        return True

    def apply_background(self):
        self.bg.load_from_string(background.css(self.look, datetime.datetime.now(), self.tokens))
        return True

    # --- hostd's events ---

    def on_event(self, ev):
        kind = ev.get("type", "")
        if kind == "display.nav":  # a controller, while the menu is in front
            verb = inp.verb_for_nav((ev.get("data") or {}).get("what", ""))
            if verb and self.is_active():
                self.device = "controller"
                self.handle(verb)
            return False
        if kind.startswith(REFRESH_ON[self.page]) and not self.pending:
            self.pending = True
            GLib.timeout_add(100, self.update)
        return False  # an idle callback runs once

    def update(self):
        self.pending = False
        options_open = self.panel.get_visible() and not self.panel.slider
        if self.is_active() and not options_open and self.asked is None:
            try:
                data = fetch(self.api, self.page, self.look, self.tokens)
            except Exception:  # noqa: BLE001 - the next event or poll tries again
                return False
            if json.dumps([r.__dict__ for r in data[0]], default=str, sort_keys=True) != self.shown:
                self.refresh(data, keep=True)
        return False

    def poll(self):
        if not self.events.connected:
            self.update()  # the event stream is down: ask every few seconds
        return True


def main():
    api = hapi.API()
    if not api.token:
        print("hostd-menu: no token: set HOSTD_TOKEN or create ~/.config/hostd/local.token", file=sys.stderr)
    app = Gtk.Application(application_id="org.hostd.Menu")

    def activate(application):
        size = theme.apply()
        win = application.get_active_window() or Menu(application, api, size)
        win.present()

    app.connect("activate", activate)
    return app.run(None)


if __name__ == "__main__":
    sys.exit(main())
