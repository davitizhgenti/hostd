# Managed by hostd's steam add-on: list the games again when Steam
# installs or removes one (its library folder changes), or makes or
# removes a game's shortcut.
[Unit]
Description=hostd: follow Steam's library

[Path]
PathModified=%h/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps
PathModified=%h/.var/app/com.valvesoftware.Steam/.local/share/applications
Unit=hostd-steam-games.service

[Install]
WantedBy=default.target
