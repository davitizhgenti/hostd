#!/bin/sh
# Managed by hostd's share-phone add-on: an Android phone on core's screen.
#
#   hostd-share-phone                      show the phone (scrcpy), as the share-phone app does
#   hostd-share-phone pair HOST:PORT CODE  once: Android's Developer options > Wireless debugging >
#                                      Pair device with pairing code gives the address and the code
#   hostd-share-phone connect HOST:PORT    save the phone's address (the one on the Wireless debugging
#                                      screen, not the pairing one), connect, and make the app
#                                      "Share: phone" (the menu lists it only after this works)
#   hostd-share-phone forget           remove the app and the saved address
#   hostd-share-phone help
#
# After pairing, adb finds the phone by itself on the same network (mDNS); the saved address
# is the fallback when it does not.
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/hostd/share-phone.addr
APPS=${XDG_CONFIG_HOME:-$HOME/.config}/hostd/apps

say() { printf 'hostd-share-phone: %s\n' "$*" >&2; }

case "${1:-}" in
help | -h | --help)
	sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
	exit 0
	;;
pair)
	[ $# -eq 3 ] || { say "use: hostd-share-phone pair HOST:PORT CODE"; exit 2; }
	exec adb pair "$2" "$3"
	;;
connect)
	[ $# -eq 2 ] || { say "use: hostd-share-phone connect HOST:PORT"; exit 2; }
	adb start-server >/dev/null 2>&1
	adb connect "$2" | tee /dev/stderr | grep -qi "connected to" || { say "could not connect to $2"; exit 1; }
	mkdir -p "$(dirname "$CONF")" "$APPS"
	printf '%s\n' "$2" >"$CONF"
	cat >"$APPS/share-phone.toml" <<APP
# Made by hostd-share-phone connect; remove it with: hostd-share-phone forget
# An Android phone on core's screen, controlled with core's keyboard and mouse (scrcpy).
name = "Share: phone"
runner = { type = "exec", command = ["/usr/local/lib/hostd/share-phone/hostd-share-phone"] }

[window]
fullscreen = true
APP
	say "connected: open \"Share: phone\" (hostctl open share-phone)"
	exit 0
	;;
forget)
	rm -f "$CONF" "$APPS/share-phone.toml"
	say "removed Share: phone and the saved address"
	exit 0
	;;
"") ;;
*)
	say "no command $1 (hostd-share-phone help)"
	exit 2
	;;
esac

adb start-server >/dev/null 2>&1
if ! adb devices | awk 'NR > 1 && $2 == "device" { found = 1 } END { exit !found }'; then
	if [ -s "$CONF" ]; then
		adb connect "$(cat "$CONF")" >/dev/null 2>&1
	fi
fi
if ! adb devices | awk 'NR > 1 && $2 == "device" { found = 1 } END { exit !found }'; then
	say "no phone found. Pair it once: Developer options > Wireless debugging > Pair device with pairing code,"
	say "then: hostd-share-phone pair HOST:PORT CODE   and   hostd-share-phone connect HOST:PORT"
	exit 1
fi
exec scrcpy --fullscreen --stay-awake
